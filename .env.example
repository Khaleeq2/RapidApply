# local | turso
RAPIDAPPLY_DATABASE_MODE=local
RAPIDAPPLY_LOCAL_DATABASE_URL=file:./data/rapidapply.local.db

# Required only when RAPIDAPPLY_DATABASE_MODE=turso.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Server-side AI provider. Keep real keys only in the ignored root .env.
# Choose exactly one provider. RapidApply never silently falls back to another.
RAPIDAPPLY_AI_PROVIDER=groq

# Gemini configuration, used only when RAPIDAPPLY_AI_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Groq configuration, used only when RAPIDAPPLY_AI_PROVIDER=groq.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Better Auth. Use a long random secret in production.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Free local email delivery logs verification/reset links to the server console.
# Use resend in production with both RESEND_API_KEY and RESEND_FROM_EMAIL.
AUTH_EMAIL_MODE=console
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Short-lived capability used only for the web-to-browser-helper handoff.
RAPIDAPPLY_EXECUTION_TICKET_TTL_SECONDS=7200

# Extension-private capability used only to report events for one claimed run.
RAPIDAPPLY_EXECUTOR_EVENT_TTL_SECONDS=14400

# autonomous_submit | review_only | test_submit
# autonomous_submit follows each campaign's autonomy policy: autonomous
# campaigns submit after verified final review; strict-control campaigns pause.
# test_submit remains available for the isolated submission verification.
RAPIDAPPLY_SUBMISSION_MODE=autonomous_submit
