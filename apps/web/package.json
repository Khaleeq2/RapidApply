  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:turso": "RAPIDAPPLY_DATABASE_MODE=turso tsx scripts/migrate.ts",
    "db:check": "tsx scripts/database-health.ts",
    "verify:executor-handoff": "RAPIDAPPLY_DATABASE_MODE=local RAPIDAPPLY_LOCAL_DATABASE_URL=file:./data/rapidapply.executor-handoff.verify.db tsx scripts/verify-executor-handoff.ts",
    "verify:submission-flow": "RAPIDAPPLY_DATABASE_MODE=local RAPIDAPPLY_LOCAL_DATABASE_URL=file:./data/rapidapply.submission-flow.verify.db tsx scripts/verify-submission-flow.ts",
